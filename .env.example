# Copie para .env e preencha. NUNCA commite o .env.
# Supabase > Project Settings > Database > Connection string (JDBC, "Session pooler" ou "Direct")
RM_DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
RM_DB_USER=postgres
RM_DB_PASSWORD=troque-me
# Gere com: openssl rand -base64 48   (minimo 32 caracteres)
RM_JWT_SECRET=troque-me-por-um-segredo-longo-e-aleatorio
RM_JWT_MINUTOS=480
RM_CORS_ORIGENS=http://localhost:5173
RM_OPENAPI=false
# resend.com > API Keys. Em branco, o e-mail de recuperacao de senha so vai pro log.
RM_RESEND_API_KEY=
# Sem dominio proprio verificado no Resend, so entrega para o e-mail da sua conta Resend.
# O nome antes do <...> aparece como remetente na caixa de entrada (menos cara de spam).
RM_EMAIL_REMETENTE=RuralManager <onboarding@resend.dev>
# Em branco, nenhum administrador e criado. Preenchido, cria na subida se ainda nao existir
# um usuario com este e-mail. RM_ADMIN_SENHA precisa ter pelo menos 12 caracteres.
RM_ADMIN_EMAIL=
RM_ADMIN_SENHA=
